---
/*
  Template 3: "a stay at Ana". Techniques from the epic-design catalogue:
  perspective zoom fly-through (facade door into the lobby), scroll-lit text,
  horizontal scroll conversion, clip-path wipe, multi-layer parallax,
  curtain panel roll-up, marquee, masked line reveal.
  Scenes use position: sticky instead of ScrollTrigger pinning, so no wrapper
  elements are added and the RO/EN swap can match both builds element by element.
*/
import { Picture } from 'astro:assets';
import '../styles/fonts.css';
import '../styles/global.css';
import { content } from '../i18n/content';
import { hotel, fromPrice, type Lang } from '../i18n/facts';

import facade from '../assets/photos/facade.jpg';
import facadeBlur from '../assets/photos/facade-blur.jpg';
import lobby from '../assets/photos/lobby.jpg';
import roomDouble from '../assets/photos/double.jpg';
import roomTwin from '../assets/photos/twin.jpg';
import roomTriple from '../assets/photos/triple.jpg';
import terrace from '../assets/photos/terrace.jpg';
import apartmentBed from '../assets/photos/apartment-bed.jpg';
import apartmentLiving from '../assets/photos/apartment-living.jpg';
import salon from '../assets/photos/salon.jpg';
import coffee from '../assets/photos/coffee.jpg';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];
const base = import.meta.env.BASE_URL;
const site = Astro.site!.origin;
const pageUrl = `${site}${base}${lang === 'en' ? 'en/' : ''}`;
const bookingUrl = `${hotel.booking}/${lang}`;
const formats = ['avif', 'webp'] as const;
const roomImages = { double: roomDouble, twin: roomTwin, triple: roomTriple };

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Hotel',
  name: hotel.name,
  description: t.description,
  url: pageUrl,
  image: `${site}${base}og.jpg`,
  telephone: hotel.phoneDesk,
  email: hotel.email,
  priceRange: `${fromPrice.single}-480 RON`,
  starRating: { '@type': 'Rating', ratingValue: 3 },
  checkinTime: '15:00',
  checkoutTime: '11:30',
  petsAllowed: false,
  address: {
    '@type': 'PostalAddress',
    streetAddress: hotel.street,
    postalCode: hotel.postal,
    addressLocality: hotel.city,
    addressCountry: 'RO',
  },
  geo: { '@type': 'GeoCoordinates', latitude: hotel.lat, longitude: hotel.lng },
  sameAs: [hotel.facebook, hotel.instagram],
};
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.title}</title>
    <meta name="description" content={t.description} />
    <!-- Concept build: remove this line when the hotel approves the launch. -->
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={pageUrl} />
    <link rel="alternate" hreflang="ro" href={`${site}${base}`} />
    <link rel="alternate" hreflang="en" href={`${site}${base}en/`} />
    <link rel="alternate" hreflang="x-default" href={`${site}${base}`} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <meta name="theme-color" content="#1c1410" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={`${site}${base}og.jpg`} />
    <meta property="og:locale" content={t.locale} />
    <script is:inline>
      // Scroll scenes are opt-in: without JS, or with reduced motion, the page stays a plain stack.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion');
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>

    <header class="top">
      <a class="brand" href={base} aria-label={hotel.name}>Ana</a>
      <span class="clock" aria-hidden="true" data-clock data-live>15:00</span>
      <nav class="nav" aria-label={t.menu}>
        {t.nav.map(([href, label]) => <a href={href}>{label}</a>)}
      </nav>
      <div class="top-actions">
        <div class="lang" role="group" aria-label={t.langLabel} data-lang-switch>
          <a href={base} hreflang="ro" lang="ro" data-lang="ro" aria-current={lang === 'ro' ? 'true' : undefined}>RO</a>
          <a href={`${base}en/`} hreflang="en" lang="en" data-lang="en" aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
        </div>
        <a class="btn btn-small top-book" href={bookingUrl}>{t.book}</a>
        <details class="menu">
          <summary>{t.menu}</summary>
          <nav aria-label={t.menu}>
            {t.nav.map(([href, label]) => <a href={href}>{label}</a>)}
          </nav>
        </details>
      </div>
    </header>

    <main id="main">
      <!-- Scene 1: arrival. The camera flies through the front door into the lobby. -->
      <section class="scene s-open" data-scene="open" data-time={t.open.time}>
        <div class="stage">
          <div class="layer depth-0" data-depth="0" aria-hidden="true">
            <Picture src={facadeBlur} alt="" formats={['webp']} widths={[240]} sizes="100vw" />
          </div>
          <div class="layer depth-1 glow glow-sun" data-depth="1" aria-hidden="true"></div>
          <div class="layer depth-2 ghost" data-depth="2" aria-hidden="true">Ana</div>
          <div class="depth-3 facade" data-depth="3" data-facade>
            <Picture
              src={facade}
              alt={t.open.alt}
              formats={formats}
              widths={[480, 768, 1100, 1536]}
              sizes="(min-width: 1000px) 62vh, 100vw"
              loading="eager"
              fetchpriority="high"
            />
          </div>
          <div class="depth-4 open-copy" data-depth="4" data-open-copy>
            <p class="eyebrow">{t.open.eyebrow}</p>
            <h1><span class="mask"><span>{t.open.lineA}</span></span> <span class="mask"><em>{t.open.lineB}</em></span></h1>
            <p class="lede">{t.open.lede}</p>
            <a class="btn" href="#rezerva">{t.open.cta}</a>
            <p class="cue" aria-hidden="true">{t.open.cue}</p>
          </div>
          <div class="lobby" data-lobby data-time={t.open.time}>
            <div class="layer depth-0 lobby-photo" data-depth="0" data-lobby-photo>
              <Picture src={lobby} alt={t.lobby.alt} formats={formats} widths={[640, 1000, 1512]} sizes="100vw" />
            </div>
            <div class="depth-4 lobby-copy" data-depth="4">
              <p class="eyebrow">{t.lobby.eyebrow}</p>
              <p class="light" data-light>{t.lobby.text}</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Scene 2: a corridor of rooms, scrolled sideways on desktop. -->
      <section class="scene s-rooms" id="camere" data-scene="rooms" data-time={t.rooms.time} data-rooms>
        <div class="stage">
          <div class="layer depth-1 glow glow-room" data-depth="1" aria-hidden="true"></div>
          <div class="depth-4 track" data-depth="4" data-track>
            <header class="rooms-head">
              <p class="eyebrow">{t.rooms.eyebrow}</p>
              <h2>{t.rooms.title}</h2>
              <p>{t.rooms.intro}</p>
            </header>
            {t.rooms.list.map((room) => (
              <article class="room" id={room.id}>
                <div class="depth-3 room-photo" data-depth="3">
                  <Picture src={roomImages[room.id]} alt={room.alt} formats={formats} widths={[480, 800, 1300]} sizes="(min-width: 1000px) 46vw, 100vw" />
                </div>
                <div class="room-copy">
                  <h3>{room.name}</h3>
                  <p class="specs">{room.specs}</p>
                  <p>{room.text}</p>
                  <p class="price"><span>{t.rooms.from}</span> <b>{fromPrice[room.price]}</b> <span>{t.rooms.perNight}</span></p>
                  <a class="link" href={bookingUrl}>{t.rooms.bookRoom}</a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- Scene 3: the terrace opens like a cinema screen. -->
      <section class="scene s-evening" id="seara" data-scene="evening" data-time={t.evening.time}>
        <div class="stage">
          <div class="layer depth-0 sunset" data-depth="0" aria-hidden="true"></div>
          <div class="layer depth-1 glow glow-dusk" data-depth="1" aria-hidden="true"></div>
          <div class="layer depth-2 ghost ghost-evening" data-depth="2" aria-hidden="true">{t.evening.ghost}</div>
          <div class="depth-3 screen" data-depth="3" data-screen>
            <Picture src={terrace} alt={t.evening.alt} formats={formats} widths={[600, 900, 1200]} sizes="(min-width: 1000px) 78vw, 100vw" />
          </div>
          <div class="depth-4 evening-copy" data-depth="4" data-evening-copy>
            <p class="eyebrow">{t.evening.eyebrow}</p>
            <h2>{t.evening.title}</h2>
            <div>
              <p>{t.evening.text}</p>
              <p class="small">{t.evening.note}</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Scene 4: the apartment at night, photos drifting at different speeds. -->
      <section class="scene s-night" id="noaptea" data-scene="night" data-time={t.night.time}>
        <div class="layer depth-1 glow glow-moon" data-depth="1" aria-hidden="true"></div>
        <div class="layer depth-5 stars" data-depth="5" aria-hidden="true"></div>
        <div class="wrap night-grid">
          <div class="depth-4 night-copy" data-depth="4" data-reveal>
            <p class="eyebrow">{t.night.eyebrow}</p>
            <h2>{t.night.title}</h2>
            <p>{t.night.text}</p>
            <dl>
              {t.night.facts.map(([term, value]) => (
                <div><dt>{term}</dt><dd>{value}</dd></div>
              ))}
            </dl>
            <p class="small">{t.night.note}</p>
            <p class="price"><span>{t.rooms.from}</span> <b>{fromPrice.apartment}</b> <span>{t.rooms.perNight}</span></p>
            <a class="btn btn-light" href={bookingUrl}>{t.book}</a>
          </div>
          <div class="depth-3 night-living" data-depth="3" data-drift="-70">
            <Picture src={apartmentLiving} alt={t.night.livingAlt} formats={formats} widths={[450, 900]} sizes="(min-width: 1000px) 34vw, 100vw" />
          </div>
          <div class="depth-2 night-bed" data-depth="2" data-drift="60">
            <Picture src={apartmentBed} alt={t.night.bedAlt} formats={formats} widths={[450, 900]} sizes="(min-width: 1000px) 28vw, 100vw" />
          </div>
        </div>
      </section>

      <!-- Scene 5: curtains part and morning light fills the lounge. -->
      <section class="scene s-morning" data-scene="morning" data-time={t.morning.time}>
        <div class="stage">
          <div class="layer depth-0 morning-photo" data-depth="0" data-morning-photo>
            <Picture src={salon} alt={t.morning.alt} formats={formats} widths={[768, 1200, 2048]} sizes="100vw" />
          </div>
          <div class="depth-3 curtain curtain-left" data-depth="3" data-curtain="-1" aria-hidden="true"></div>
          <div class="depth-3 curtain curtain-right" data-depth="3" data-curtain="1" aria-hidden="true"></div>
          <div class="depth-4 morning-copy" data-depth="4" data-morning-copy>
            <p class="eyebrow">{t.morning.eyebrow}</p>
            <h2>{t.morning.title}</h2>
            <p>{t.morning.text}</p>
          </div>
        </div>
      </section>

      <section class="morning-extra wrap" data-time={t.morning.time}>
        <figure data-reveal>
          <blockquote>{t.morning.quote}</blockquote>
          <figcaption>{t.morning.quoteBy}</figcaption>
        </figure>
        <div class="morning-coffee" data-drift="-40">
          <Picture src={coffee} alt={t.morning.coffeeAlt} formats={formats} widths={[400, 800]} sizes="(min-width: 1000px) 34vw, 100vw" />
        </div>
      </section>

      <!-- Scene 6: the city, with a moving line of places. -->
      <section class="s-city" id="zona" data-scene="city" data-time={t.city.time}>
        <div class="marquee" aria-hidden="true" data-depth="2">
          <div class="marquee-run">
            {[0, 1].map(() => t.city.marquee.map((place) => <span>{place}</span>))}
          </div>
        </div>
        <div class="wrap city-grid">
          <header data-reveal>
            <p class="eyebrow">{t.city.eyebrow}</p>
            <h2>{t.city.title}</h2>
            <p>{t.city.intro}</p>
            <a class="link" href={hotel.directions} rel="noopener">{t.city.directions}</a>
          </header>
          <dl data-reveal>
            {t.city.items.map(([place, distance]) => (
              <div><dt>{place}</dt><dd>{distance}</dd></div>
            ))}
          </dl>
        </div>
      </section>

      <!-- Scene 7: departure, booking and practical details. -->
      <section class="s-leave" id="plecare" data-scene="leave" data-time={t.leave.time}>
        <div class="wrap">
          <header class="leave-head" data-reveal>
            <p class="eyebrow">{t.leave.eyebrow}</p>
            <h2>{t.leave.title}</h2>
          </header>
          <form class="book" action={bookingUrl} method="get" id="rezerva" aria-label={t.leave.form.label} data-book>
            <input type="hidden" name="currency" value="RON" />
            <label><span>{t.leave.form.checkin}</span><input type="date" name="checkin" required /></label>
            <label><span>{t.leave.form.checkout}</span><input type="date" name="checkout" required /></label>
            <label>
              <span>{t.leave.form.adults}</span>
              <select name="adults">
                <option>1</option>
                <option selected>2</option>
                <option>3</option>
                <option>4</option>
              </select>
            </label>
            <button class="btn" type="submit">{t.leave.form.submit}</button>
            <p class="book-note">{t.leave.form.note}</p>
          </form>
          <ul class="scores" data-reveal>
            {t.leave.scores.map(([value, source]) => (
              <li><b>{value}</b><span>{source}</span></li>
            ))}
          </ul>
          <h3 class="info-title">{t.leave.infoTitle}</h3>
          <dl class="info" data-reveal>
            {t.leave.info.map(([term, text]) => (
              <div><dt>{term}</dt><dd>{text}</dd></div>
            ))}
          </dl>
        </div>
      </section>
    </main>

    <footer class="contact" id="contact">
      <div class="wrap contact-grid">
        <div>
          <h2>{t.contact.title}</h2>
          <a class="btn btn-light" href={hotel.whatsapp} rel="noopener">{t.contact.whatsapp}</a>
        </div>
        <dl>
          <div><dt>{t.contact.mobile}</dt><dd><a href={`tel:${hotel.phoneMobile}`}>{hotel.phoneMobileLabel}</a></dd></div>
          <div><dt>{t.contact.desk}</dt><dd><a href={`tel:${hotel.phoneDesk}`}>{hotel.phoneDeskLabel}</a></dd></div>
          <div><dt>{t.contact.email}</dt><dd><a href={`mailto:${hotel.email}`}>{hotel.email}</a></dd></div>
          <div><dt>{t.contact.address}</dt><dd><a href={hotel.directions} rel="noopener">{hotel.street}, {hotel.city}</a></dd></div>
        </dl>
      </div>
      <div class="wrap legal">
        <p>{t.contact.languages}</p>
        <ul>
          <li><a href={hotel.facebook} rel="noopener">Facebook</a></li>
          <li><a href={hotel.instagram} rel="noopener">Instagram</a></li>
          {t.footer.policies.map(([label, href]) => <li><a href={href} rel="noopener">{label}</a></li>)}
        </ul>
        <p>© {new Date().getFullYear()} {hotel.company}, CUI {hotel.cui}. {t.footer.rights} {t.footer.concept}</p>
      </div>
    </footer>

    <nav class="dock" aria-label={t.book}>
      <a class="btn btn-ghost" href={`tel:${hotel.phoneMobile}`}>{t.call}</a>
      <a class="btn" href="#rezerva">{t.book}</a>
    </nav>

    <script>
      import { initScenes } from '../scripts/scenes';
      import { initPage } from '../scripts/page';

      initPage();
      if (document.documentElement.classList.contains('motion')) {
        try {
          initScenes();
        } catch {
          // A failed animation must never hide content.
          document.documentElement.classList.remove('motion');
        }
      }
    </script>
  </body>
</html>
